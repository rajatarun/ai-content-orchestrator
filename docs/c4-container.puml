@startuml C4-L2-Containers
!pragma layout smetana

' ─────────────────────────────────────────────────────────────────
'  C4 Architecture — TaskWeave Content Orchestrator
'  Level 2: Container Diagram
'
'  C4-PlantUML library files are bundled locally in:
'  docs/plantuml-libs/C4/
'  Source: https://github.com/plantuml-stdlib/C4-PlantUML
'
'  Render from the docs/ directory:
'    cd docs && plantuml c4-container.puml
' ─────────────────────────────────────────────────────────────────

!define C4Puml plantuml-libs/C4
!include C4Puml/C4_Container.puml

LAYOUT_WITH_LEGEND()

title [L2] Container Diagram — TaskWeave Content Orchestrator

Person(admin, "Content Admin", "Internal user managing content")
Person(subscriber, "Subscriber", "Receives newsletter")
Person(siteVisitor, "Site Visitor", "Reads articles")

System_Boundary(contentSystem, "TaskWeave Content Orchestrator") {

    Container(apiGateway, "REST API Gateway", "AWS API Gateway", "Routes HTTP requests to Lambda functions.\nHandles CORS, stages (prod)")

    Container(adminApi, "Admin API", "AWS Lambda / Python 3.11", "Handles article CRUD, status actions,\nsubscriber management, newsletter triggers")

    Container(publicApi, "Public API", "AWS Lambda / Python 3.11", "Handles newsletter subscription.\nManages SES contact list.")

    Container(appointmentApi, "Appointment API", "AWS Lambda / Python 3.11", "Accepts appointment requests.\nSends SES notification to admin.")

    Container(siteData, "Site Data API", "AWS Lambda / Python 3.11", "Serves published articles from S3.\nUsed by public-facing website.")

    Container(generateDrafts, "Generate Drafts", "AWS Lambda / Python 3.11", "Orchestrates AI draft generation.\nPrimary: TeamWeave. Fallback: Gemini direct.\nRuns on EventBridge schedule (Mon 15:15 UTC).")

    Container(newsletter, "Newsletter", "AWS Lambda / Python 3.11", "Generates weekly newsletter via Gemini.\nSends to all active subscribers via SES.\nRuns on EventBridge schedule (Mon 00:00 UTC).")

    ContainerDb(dynamodb, "Content Table", "AWS DynamoDB", "Stores articles, audit events, subscribers.\nPAY_PER_REQUEST billing.\nGSIs: StatusUpdatedIndex, StatusPublishedIndex")

    ContainerDb(s3Articles, "Articles Bucket", "AWS S3", "Stores published article JSON files.\nPath: docs/articles/{articleId}.json")

    ContainerDb(s3Artifacts, "Artifact Bucket", "AWS S3 (shared stack)", "Stores TeamWeave run artifacts.\nPath: runs/{runId}/writer_linkedin.json")

    Container(secretsManager, "Secrets Manager", "AWS Secrets Manager", "Stores Gemini API key as JSON:\n{ key: ... }")

    Container(snsTopic, "Approval Notification", "AWS SNS Topic", "Notifies reviewer by email when\na draft is ready for approval.")

    Container(eventBridge, "EventBridge Rules", "AWS EventBridge", "WeeklyGenerateDraftsRule: Mon 15:15 UTC\nWeeklyNewsletterRule: Mon 00:00 UTC")
}

System_Ext(teamWeaveApi, "TeamWeave Team API", "Step Functions orchestration\nfor AI writer agents")
System_Ext(geminiApi, "Google Gemini API", "Generative AI content model")
System_Ext(sesAws, "AWS SES", "Email sending service")

Rel(admin, apiGateway, "REST calls", "HTTPS")
Rel(subscriber, apiGateway, "POST /public/subscribe", "HTTPS")
Rel(siteVisitor, apiGateway, "GET /site/posts", "HTTPS")

Rel(apiGateway, adminApi, "Routes /admin/*", "Lambda proxy")
Rel(apiGateway, publicApi, "Routes /public/subscribe", "Lambda proxy")
Rel(apiGateway, appointmentApi, "Routes /public/appointment", "Lambda proxy")
Rel(apiGateway, siteData, "Routes /site/posts", "Lambda proxy")

Rel(adminApi, dynamodb, "Read/Write articles, subscribers, events", "AWS SDK")
Rel(adminApi, s3Articles, "PUT approved article JSON", "AWS SDK")
Rel(adminApi, generateDrafts, "Invoke async (generate action)", "Lambda.invoke Event")
Rel(adminApi, newsletter, "Invoke sync (generate/send)", "Lambda.invoke RequestResponse")

Rel(generateDrafts, dynamodb, "Read/Write article + events", "AWS SDK")
Rel(generateDrafts, secretsManager, "GetSecretValue (Gemini key)", "AWS SDK")
Rel(generateDrafts, s3Artifacts, "GetObject writer_linkedin.json", "AWS SDK")
Rel(generateDrafts, snsTopic, "Publish approval notification", "AWS SDK")
Rel(generateDrafts, teamWeaveApi, "POST /team/task (SigV4)", "HTTPS")
Rel(generateDrafts, geminiApi, "Fallback: generate JSON drafts", "HTTPS")

Rel(newsletter, dynamodb, "Query published articles + subscribers", "AWS SDK")
Rel(newsletter, secretsManager, "GetSecretValue (Gemini key)", "AWS SDK")
Rel(newsletter, geminiApi, "Generate newsletter content", "HTTPS")
Rel(newsletter, sesAws, "SendEmail to subscribers", "AWS SDK")

Rel(publicApi, dynamodb, "Write subscriber record", "AWS SDK")
Rel(publicApi, sesAws, "CreateContact / UpdateContact", "AWS SDK")
Rel(appointmentApi, sesAws, "Send appointment notification", "AWS SDK")
Rel(siteData, s3Articles, "ListBucket + GetObject articles", "AWS SDK")

Rel(eventBridge, generateDrafts, "Trigger weekly (Mon 15:15)", "EventBridge rule")
Rel(eventBridge, newsletter, "Trigger weekly (Mon 00:00)", "EventBridge rule")

@enduml
