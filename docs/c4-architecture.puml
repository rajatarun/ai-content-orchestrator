@startuml C4-TaskWeave-Content-Orchestrator

' ─────────────────────────────────────────────────────────────────
'  C4 Architecture — TaskWeave Content Orchestrator
'  C4-PlantUML library files are bundled locally in:
'  docs/plantuml-libs/C4/
'  Source: https://github.com/plantuml-stdlib/C4-PlantUML
'
'  Render from the docs/ directory:
'    cd docs && plantuml c4-architecture.puml
' ─────────────────────────────────────────────────────────────────

!define C4Puml plantuml-libs/C4
!include C4Puml/C4_Context.puml
!include C4Puml/C4_Container.puml
!include C4Puml/C4_Component.puml

' ═══════════════════════════════════════════════════════════════
'  LEVEL 1 — SYSTEM CONTEXT
' ═══════════════════════════════════════════════════════════════

title [L1] System Context — TaskWeave Content Orchestrator

LAYOUT_WITH_LEGEND()

Person(admin, "Content Admin", "Reviews, approves, and manages LinkedIn content drafts via admin API")
Person(subscriber, "Newsletter Subscriber", "Receives weekly email newsletter of published content")
Person(siteVisitor, "Site Visitor", "Reads published articles via public website")

System(contentOrchestrator, "TaskWeave Content Orchestrator", "Automates LinkedIn content creation, approval workflow, and newsletter delivery")

System_Ext(geminiApi, "Google Gemini API", "Generative AI for LinkedIn draft and newsletter content generation")
System_Ext(teamWeaveApi, "TeamWeave Content Team API", "Orchestrates AI writer agents via Step Functions. Produces LinkedIn drafts.")
System_Ext(sesService, "AWS SES", "Transactional and bulk email delivery service")
System_Ext(googleSearch, "Google Search", "Web search grounding for Gemini-generated content")

Rel(admin, contentOrchestrator, "Creates articles, triggers generation, approves drafts", "HTTPS/REST")
Rel(subscriber, contentOrchestrator, "Subscribes to newsletter", "HTTPS/REST")
Rel(siteVisitor, contentOrchestrator, "Reads published posts", "HTTPS/REST")
Rel(contentOrchestrator, geminiApi, "Generates drafts and newsletter content", "HTTPS/JSON")
Rel(contentOrchestrator, teamWeaveApi, "Requests AI-generated LinkedIn drafts", "HTTPS/SigV4")
Rel(contentOrchestrator, sesService, "Sends newsletter and notification emails", "AWS SDK")
Rel(geminiApi, googleSearch, "Grounds responses with live web data", "Internal")

@enduml

' ═══════════════════════════════════════════════════════════════
'  LEVEL 2 — CONTAINER DIAGRAM
' ═══════════════════════════════════════════════════════════════

@startuml C4-L2-Containers

!define C4Puml plantuml-libs/C4
!include C4Puml/C4_Container.puml

LAYOUT_WITH_LEGEND()

title [L2] Container Diagram — TaskWeave Content Orchestrator

Person(admin, "Content Admin", "Internal user managing content")
Person(subscriber, "Subscriber", "Receives newsletter")
Person(siteVisitor, "Site Visitor", "Reads articles")

System_Boundary(contentSystem, "TaskWeave Content Orchestrator") {

    Container(apiGateway, "REST API Gateway", "AWS API Gateway", "Routes HTTP requests to Lambda functions.\nHandles CORS, stages (prod)")

    Container(adminApi, "Admin API", "AWS Lambda / Python 3.11", "Handles article CRUD, status actions,\nsubscriber management, newsletter triggers")

    Container(publicApi, "Public API", "AWS Lambda / Python 3.11", "Handles newsletter subscription.\nManages SES contact list.")

    Container(appointmentApi, "Appointment API", "AWS Lambda / Python 3.11", "Accepts appointment requests.\nSends SES notification to admin.")

    Container(siteData, "Site Data API", "AWS Lambda / Python 3.11", "Serves published articles from S3.\nUsed by public-facing website.")

    Container(generateDrafts, "Generate Drafts", "AWS Lambda / Python 3.11", "Orchestrates AI draft generation.\nPrimary: TeamWeave. Fallback: Gemini direct.\nRuns on EventBridge schedule (Mon 15:15 UTC).")

    Container(newsletter, "Newsletter", "AWS Lambda / Python 3.11", "Generates weekly newsletter via Gemini.\nSends to all active subscribers via SES.\nRuns on EventBridge schedule (Mon 00:00 UTC).")

    ContainerDb(dynamodb, "Content Table", "AWS DynamoDB", "Stores articles, audit events, subscribers.\nPAY_PER_REQUEST billing.\nGSIs: StatusUpdatedIndex, StatusPublishedIndex")

    ContainerDb(s3Articles, "Articles Bucket", "AWS S3", "Stores published article JSON files.\nPath: docs/articles/{articleId}.json")

    ContainerDb(s3Artifacts, "Artifact Bucket", "AWS S3 (shared stack)", "Stores TeamWeave run artifacts.\nPath: runs/{runId}/writer_linkedin.json")

    Container(secretsManager, "Secrets Manager", "AWS Secrets Manager", "Stores Gemini API key as JSON:\n{ \"key\": \"...\" }")

    Container(snsTopic, "Approval Notification", "AWS SNS Topic", "Notifies reviewer by email when\na draft is ready for approval.")

    Container(eventBridge, "EventBridge Rules", "AWS EventBridge", "WeeklyGenerateDraftsRule: Mon 15:15 UTC\nWeeklyNewsletterRule: Mon 00:00 UTC")
}

System_Ext(teamWeaveApi, "TeamWeave Team API", "Step Functions orchestration\nfor AI writer agents")
System_Ext(geminiApi, "Google Gemini API", "Generative AI content model")
System_Ext(sesAws, "AWS SES", "Email sending service")

Rel(admin, apiGateway, "REST calls", "HTTPS")
Rel(subscriber, apiGateway, "POST /public/subscribe", "HTTPS")
Rel(siteVisitor, apiGateway, "GET /site/posts", "HTTPS")

Rel(apiGateway, adminApi, "Routes /admin/*", "Lambda proxy")
Rel(apiGateway, publicApi, "Routes /public/subscribe", "Lambda proxy")
Rel(apiGateway, appointmentApi, "Routes /public/appointment", "Lambda proxy")
Rel(apiGateway, siteData, "Routes /site/posts", "Lambda proxy")

Rel(adminApi, dynamodb, "Read/Write articles, subscribers, events", "AWS SDK")
Rel(adminApi, s3Articles, "PUT approved article JSON", "AWS SDK")
Rel(adminApi, generateDrafts, "Invoke async (generate action)", "Lambda.invoke Event")
Rel(adminApi, newsletter, "Invoke sync (generate/send)", "Lambda.invoke RequestResponse")

Rel(generateDrafts, dynamodb, "Read/Write article + events", "AWS SDK")
Rel(generateDrafts, secretsManager, "GetSecretValue (Gemini key)", "AWS SDK")
Rel(generateDrafts, s3Artifacts, "GetObject writer_linkedin.json", "AWS SDK")
Rel(generateDrafts, snsTopic, "Publish approval notification", "AWS SDK")
Rel(generateDrafts, teamWeaveApi, "POST /team/task (SigV4)", "HTTPS")
Rel(generateDrafts, geminiApi, "Fallback: generate JSON drafts", "HTTPS")

Rel(newsletter, dynamodb, "Query published articles + subscribers", "AWS SDK")
Rel(newsletter, secretsManager, "GetSecretValue (Gemini key)", "AWS SDK")
Rel(newsletter, geminiApi, "Generate newsletter content", "HTTPS")
Rel(newsletter, sesAws, "SendEmail to subscribers", "AWS SDK")

Rel(publicApi, dynamodb, "Write subscriber record", "AWS SDK")
Rel(publicApi, sesAws, "CreateContact / UpdateContact", "AWS SDK")
Rel(appointmentApi, sesAws, "Send appointment notification", "AWS SDK")
Rel(siteData, s3Articles, "ListBucket + GetObject articles", "AWS SDK")

Rel(eventBridge, generateDrafts, "Trigger weekly (Mon 15:15)", "EventBridge rule")
Rel(eventBridge, newsletter, "Trigger weekly (Mon 00:00)", "EventBridge rule")

@enduml

' ═══════════════════════════════════════════════════════════════
'  LEVEL 3 — COMPONENT DIAGRAM (Generate Drafts Lambda)
' ═══════════════════════════════════════════════════════════════

@startuml C4-L3-GenerateDrafts

!define C4Puml plantuml-libs/C4
!include C4Puml/C4_Component.puml

LAYOUT_WITH_LEGEND()

title [L3] Component Diagram — Generate Drafts Lambda

Container_Boundary(generateDrafts, "GenerateDrafts Lambda") {

    Component(handler, "generate_drafts_handler", "Python function", "Entry point.\nResolves article inputs, orchestrates generation,\npersists result.")

    Component(inputResolver, "_resolve_generation_inputs", "Python function", "Reads articleId from event.\nFetches article from DynamoDB.\nExtracts topic and objective.")

    Component(teamweaveClient, "createTeamTask + pollExecution", "Python functions", "Posts task to TeamWeave API (SigV4 signed).\nPolls Step Functions execution status.\nFetches writer artifact from S3.")

    Component(bauGenerator, "fallbackToBAUGeneration", "Python function", "Builds structured Gemini prompt.\nCalls Gemini API directly.\nReturns normalized draft list.")

    Component(persistor, "_persist_generation_result", "Python function", "Updates article status to AWAITING_APPROVAL.\nStores generated drafts in DynamoDB.\nAdds audit event.\nPublishes SNS notification.")

    Component(notifier, "_notify_approval_requested", "Python function", "Publishes SNS message with article details\nto ApprovalNotificationTopic.")
}

Component_Ext(dbModule, "db.py", "DynamoDB operations module", "get_article, update_article, add_event")
Component_Ext(geminiModule, "gemini_client.py", "Gemini API client module", "gemini_generate_json")
Component_Ext(secretsModule, "aws_secrets.py", "Secrets Manager module", "get_secret_json")

System_Ext(teamWeaveApi, "TeamWeave API", "POST /team/task")
System_Ext(stepFunctions, "AWS Step Functions", "DescribeExecution")
System_Ext(s3, "AWS S3 Artifact Bucket", "writer_linkedin.json")
System_Ext(geminiApi, "Google Gemini API", "generateContent")
System_Ext(dynamoDb, "AWS DynamoDB", "ContentTable")
System_Ext(snsTopicExt, "AWS SNS", "ApprovalNotificationTopic")

Rel(handler, inputResolver, "calls")
Rel(handler, teamweaveClient, "calls (primary path)")
Rel(handler, bauGenerator, "calls (fallback path)")
Rel(handler, persistor, "calls")

Rel(inputResolver, dbModule, "get_article()")
Rel(teamweaveClient, teamWeaveApi, "POST /team/task (SigV4)")
Rel(teamweaveClient, stepFunctions, "DescribeExecution polling")
Rel(teamweaveClient, s3, "GetObject artifact")
Rel(bauGenerator, geminiModule, "gemini_generate_json()")
Rel(geminiModule, secretsModule, "get_secret_json()")
Rel(geminiModule, geminiApi, "HTTPS POST")
Rel(persistor, dbModule, "update_article(), add_event()")
Rel(persistor, notifier, "calls")
Rel(notifier, snsTopicExt, "sns.publish()")
Rel(dbModule, dynamoDb, "DynamoDB SDK calls")

@enduml

' ═══════════════════════════════════════════════════════════════
'  LEVEL 3 — COMPONENT DIAGRAM (Admin API Lambda)
' ═══════════════════════════════════════════════════════════════

@startuml C4-L3-AdminApi

!define C4Puml plantuml-libs/C4
!include C4Puml/C4_Component.puml

LAYOUT_WITH_LEGEND()

title [L3] Component Diagram — Admin API Lambda

Container_Boundary(adminApiLambda, "AdminAPI Lambda") {

    Component(handler, "lambda_handler", "Python function", "Routes incoming HTTP requests\nbased on path + method.")

    Component(articleCrud, "Article CRUD handlers", "Python functions", "POST /admin/articles — create\nGET /admin/articles — list by status\nGET /admin/articles/{id} — get\nPATCH /admin/articles/{id} — update")

    Component(actionHandlers, "Action Handlers", "Python functions", "generate → async Lambda invoke\napprove → update + S3 publish\nrequest-edits → REVISION_REQUESTED\nreject → FAILED\nsubmit-for-approval → AWAITING_APPROVAL\nmark-failed → FAILED\narchive → ARCHIVED\nmark-published → PUBLISHED")

    Component(newsletterProxy, "Newsletter Proxy", "Python functions", "generate → sync invoke NewsletterFunction\nsend → sync invoke NewsletterFunction")

    Component(subscriberHandlers, "Subscriber CRUD", "Python functions", "GET/POST/DELETE /admin/subscribers")

    Component(ctaDecorator, "_decorate_article_with_actions", "Python function", "Appends available CTA list per status.\nSets ctaPresentation: dropdown/inline.")

    Component(publisher, "publisher.py", "S3 publish module", "publish_article_to_s3()\nUploads article JSON to S3.")
}

System_Ext(dynamoDb, "AWS DynamoDB", "ContentTable")
System_Ext(s3, "AWS S3", "Articles bucket docs/articles/")
System_Ext(lambdaService, "AWS Lambda", "GenerateDraftsFunction\nNewsletterFunction")

Rel(handler, articleCrud, "routes article requests")
Rel(handler, actionHandlers, "routes /actions/* requests")
Rel(handler, newsletterProxy, "routes /newsletter/actions/*")
Rel(handler, subscriberHandlers, "routes /subscribers/*")
Rel(articleCrud, ctaDecorator, "decorates response")
Rel(actionHandlers, ctaDecorator, "decorates response")
Rel(actionHandlers, publisher, "on approve action")
Rel(actionHandlers, lambdaService, "invoke GenerateDraftsFunction (async)")
Rel(newsletterProxy, lambdaService, "invoke NewsletterFunction (sync)")
Rel(articleCrud, dynamoDb, "CRUD operations via db.py")
Rel(subscriberHandlers, dynamoDb, "subscriber operations via db.py")
Rel(publisher, s3, "PutObject")

@enduml
